# Source this file after activating the project's Python environment.
if [ -z "${python_config_path:-}" ]; then
    python_config_path=$(python - <<'PY'
import shutil
import sys
import sysconfig
from pathlib import Path

name = f"python{sysconfig.get_python_version()}-config"
candidates = [
    Path(sysconfig.get_config_var("LIBPL") or sys.base_prefix) / name,
    Path(sys.base_prefix) / "bin" / name,
]
if found := shutil.which(name):
    candidates.append(Path(found))
config = next((path for path in candidates if path.is_file()), None)
if config is None:
    sys.exit(f"Cannot find {name}; set python_config_path before sourcing env.sh.")
print(config)
PY
    ) || return 1
fi
export python_config_path
export MUJOCO_GL=egl
# Use serial operator compilation for reliable startup.
export use_parallel_op_compiler=${use_parallel_op_compiler:-0}
